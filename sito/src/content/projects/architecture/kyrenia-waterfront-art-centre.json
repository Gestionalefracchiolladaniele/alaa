  "texts": [
    { "heading": "History Reimagined", "body": "An adaptive reuse project that breathes new life into a historic stone building in Kyrenia Harbour, Cyprus, transforming it into a vibrant Art Centre while adding a contemporary sculptural pavilion on the waterfront. The design celebrates the site's cultural heritage, maritime character, and public life, creating a lively destination for art, exhibition, learning, and community gathering." },
    { "heading": "Site Analysis — Kyrenia Harbour", "items": [
      "Historic context: Venetian / Ottoman heritage, historic harbour.",
      "Climate: Mediterranean, with hot, dry summers and mild, wet winters.",
      "Pedestrian network: harbour promenade and existing urban fabric links.",
      "Marina connection: active boat berths, tourism and waterfront life."
    ] },
    { "heading": "Adaptive Reuse Strategy", "items": [
      "Retain — preserve the historic mass, roof form and masonry character.",
      "Restore — repair stonework, reopen original openings, enhance structural integrity.",
      "Insert — introduce contemporary art functions, services and accessibility with reversible interventions."
    ] }
  ],
