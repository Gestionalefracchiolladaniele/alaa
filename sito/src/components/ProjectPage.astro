---
/* Template della pagina progetto ("tavola interattiva", 02-esperienza.md). Versione statica (F2).
   Agganci per F3–F6 / Fable:
     [data-project-hero]      immagine principale (destinazione della transizione dalla pellicola: view-transition-name)
     [data-hotspots]          contenitore dei punti cliccabili (dati in project.hotspots, x/y in %)
     [data-model-viewer]      visualizzatore 3D (solo creo-sharjah e kyrenia-waterfront-art-centre):
                              data-model-file, data-model-kind ("configurator" | "exploded"), data-fallback-slot;
                              dentro: [data-model-canvas] vuoto e [data-model-fallback] con l'immagine di riserva
     [data-palette]           palette da aprire a ventaglio; ogni colore [data-swatch] con data-hex
     [data-compare]           slider alzato ↔ immagine: [data-compare-drawing] e [data-compare-photo]
     [data-counter]           numeri chiave da animare
     [data-diagram]           disegni da ridisegnare in SVG e tracciare con lo scroll (p13, p16) */
import Base from '../layouts/Base.astro';
import BookNav from './BookNav.astro';
import Slot from './Slot.astro';
import TwoTone from './TwoTone.astro';
import Icon from './Icon.astro';
import { urlOf, type Project } from '../lib/projects';

interface Props { project: Project; prev?: Project; next?: Project }
const { project, prev, next } = Astro.props;
const d = project.data;
const kindLabel = d.kind === 'interior' ? 'Interior Design' : 'Architecture';
const back = `/#${d.kind}-film`;
const heroName = `hero-${project.id.split('/').pop()}`;
---
<Base title={`${d.shortTitle} — Arch. Alaa Attal`} description={d.summary} bodyClass="project">
  <BookNav current={d.kind} />
  <main id="main" class="pj" data-project={project.id} data-pdf-page={d.page}>
    <header class="pj__head wrap">
      <p class="label pj__crumbs"><a href={back}>{kindLabel}</a> <span aria-hidden="true">/</span> PDF p{d.page}</p>
      {d.script && <p class="script pj__script">{d.script}</p>}
      <TwoTone title={d.title} as="h1" class="pj__title" />
      {d.subtitle && <p class="label pj__sub">{d.subtitle}</p>}
      <ul class="label label-list pj__meta">
        {d.location && <li>{d.location}</li>}
        {d.type && <li>{d.type}</li>}
        {d.brand && <li>{d.brand}</li>}
      </ul>
    </header>

    <section class="pj__hero wrap" aria-label="Main image">
      {d.model ? (
        <div class="pj__model" data-model-viewer data-model-file={d.model.file} data-model-kind={d.model.kind} data-fallback-slot={d.hero}>
          <div class="pj__model-canvas" data-model-canvas></div>
          <figure class="pj__figure" data-model-fallback data-project-hero style={`view-transition-name:${heroName}`}>
            <Slot id={d.hero} sizes="(min-width: 1320px) 1320px, 100vw" loading="eager" fetchpriority="high" />
          </figure>
          <p class="label pj__model-note">3D study based on the project board</p>
        </div>
      ) : (
        <figure class:list={['pj__figure', { 'pj__figure--small': d.needsOriginals }]} data-project-hero style={`view-transition-name:${heroName}`}>
          <Slot id={d.hero} sizes={d.needsOriginals ? '(min-width: 900px) 760px, 100vw' : '(min-width: 1320px) 1320px, 100vw'} loading="eager" fetchpriority="high" />
          <div class="pj__hotspots" data-hotspots={JSON.stringify(d.hotspots)}>
            {d.hotspots.map((h) => (
              <button type="button" class="pj__hotspot" style={`left:${h.x}%;top:${h.y}%`} data-ref={h.ref}><span class="visually-hidden">{h.label}</span></button>
            ))}
          </div>
        </figure>
      )}
      {d.needsOriginals && <p class="small muted pj__note">Board shown at reduced size until the original drawings are available.</p>}
    </section>

    {d.texts.length > 0 && (
      <section class="pj__texts wrap" aria-label="Design texts">
        {d.texts.map((t) => (
          <div class="pj__text">
            <h2 class="heading">{t.heading}</h2>
            {t.body && (Array.isArray(t.body) ? t.body.map((b) => <p>{b}</p>) : <p>{t.body}</p>)}
            {t.items && <ul class="pj__items">{t.items.map((x) => <li>{x}</li>)}</ul>}
          </div>
        ))}
      </section>
    )}

    {d.palette.length > 0 && (
      <section class="pj__palette wrap" aria-labelledby="pal-h">
        <h2 class="heading" id="pal-h">Palette</h2>
        <ul class="pal" data-palette>
          {d.palette.map((c) => (
            <li class="pal__c" data-swatch data-hex={c.hex}>
              <span class="pal__chip" style={`background:${c.hex}`}></span>
              <span class="label">{c.name}</span>
              {c.note && <span class="small muted">{c.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.groups.map((g) => (
      <section class="pj__group wrap" aria-label={g.heading}>
        <h2 class="heading">{g.heading}</h2>
        <ul class:list={['cards', { 'cards--list': g.layout !== 'cards' || g.items.every((i) => !i.slot) }]}>
          {g.items.map((it) => (
            <li class="card">
              {it.slot && <span class="card__img"><Slot id={it.slot} sizes="(min-width: 900px) 220px, 45vw" max={600} /></span>}
              <span class="card__name">{it.name}</span>
              {it.note && <span class="small muted">{it.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}

    {d.features.length > 0 && (
      <section class="pj__features wrap" aria-labelledby="feat-h">
        <h2 class="heading" id="feat-h">Key Features</h2>
        <ul class="feats">
          {d.features.map((f) => (
            <li><Icon name={f.icon} size={32} /><div><p class="feats__t">{f.title}</p>{f.text && <p class="small">{f.text}</p>}</div></li>
          ))}
        </ul>
      </section>
    )}

    {d.compare && (
      <section class="pj__compare wrap" aria-labelledby="cmp-h">
        <h2 class="heading" id="cmp-h">Elevation and image</h2>
        <div class="compare" data-compare>
          <figure data-compare-drawing><Slot id={d.compare.drawing} sizes="(min-width: 900px) 50vw, 100vw" max={1200} /><figcaption class="label">Elevation</figcaption></figure>
          <figure data-compare-photo><Slot id={d.compare.photo} sizes="(min-width: 900px) 50vw, 100vw" max={1200} /><figcaption class="label">Image</figcaption></figure>
        </div>
      </section>
    )}

    {d.stats.length > 0 && (
      <section class="pj__stats wrap" aria-labelledby="stats-h">
        <h2 class="heading" id="stats-h">{d.kind === 'architecture' ? 'Project Data' : 'Project Details'}</h2>
        <dl class="stats">
          {d.stats.map((s) => <div><dt class="label">{s.label}</dt><dd data-counter>{s.value}</dd></div>)}
        </dl>
      </section>
    )}

    {d.drawings.filter((x) => !(d.compare && x.slot === d.compare.drawing)).length > 0 && (
      <section class="pj__drawings wrap" aria-labelledby="dr-h">
        <h2 class="heading" id="dr-h">Drawings</h2>
        <ul class:list={['drawings', { 'drawings--small': d.needsOriginals }]}>
          {d.drawings.filter((x) => !(d.compare && x.slot === d.compare.drawing) && x.slot !== d.hero).map((x) => (
            <li><figure data-diagram={x.slot}><Slot id={x.slot} sizes="(min-width: 900px) 40vw, 100vw" max={1200} /><figcaption class="small">{x.caption}</figcaption></figure></li>
          ))}
        </ul>
      </section>
    )}

    {d.legends.length > 0 && (
      <section class="pj__legends wrap" aria-labelledby="lg-h">
        <h2 class="heading" id="lg-h">Legend</h2>
        <div class="legends">
          {d.legends.map((l) => (
            <div><p class="label">{l.heading}</p><ol class="legend">{l.items.map((it) => <li>{it.key && <b class="legend__k">{it.key}</b>}{it.label}</li>)}</ol></div>
          ))}
        </div>
      </section>
    )}

    {d.gallery.length > 0 && (
      <section class="pj__gallery wrap" aria-labelledby="gal-h">
        <h2 class="heading" id="gal-h">Views & details</h2>
        <ul class="gallery">
          {d.gallery.map((g) => <li><figure><Slot id={g.slot} sizes="(min-width: 900px) 33vw, 100vw" max={1200} />{g.caption && <figcaption class="small">{g.caption}</figcaption>}</figure></li>)}
        </ul>
      </section>
    )}

    <nav class="pj__nav wrap" aria-label="More projects">
      {prev ? <a class="pj__prev" href={urlOf(prev)}><span class="label">Previous</span><span>{prev.data.shortTitle}</span></a> : <span></span>}
      <a class="btn btn--ghost" href={back}>Back to the film</a>
      {next ? <a class="pj__next" href={urlOf(next)}><span class="label">Next</span><span>{next.data.shortTitle}</span></a> : <span></span>}
    </nav>
  </main>
</Base>

<style>
  .pj { padding-block: clamp(4rem, 8vw, 6rem) var(--s-9); }
  .pj > section { margin-top: clamp(3rem, 6vw, 5rem); }
  .pj__crumbs a { text-decoration: none; color: var(--accent); }
  .pj__script { margin: var(--s-5) 0 0; }
  .pj__title { font-size: clamp(2.6rem, 7vw, 6rem); line-height: .95; margin: .25em 0 .3em; }
  .pj__sub { margin: 0 0 .4em; }
  .pj__meta { opacity: .8; }
  .pj__figure { position: relative; margin: 0; }
  .pj__figure :global(img) { width: 100%; height: auto; border-radius: 3px; box-shadow: var(--shadow-2); }
  .pj__figure--small { max-width: 760px; }
  .pj__hotspots { position: absolute; inset: 0; pointer-events: none; }
  .pj__hotspot { position: absolute; pointer-events: auto; width: 22px; height: 22px; margin: -11px; border-radius: 50%; border: 2px solid var(--paper); background: var(--accent); cursor: pointer; }
  .pj__model { position: relative; }
  .pj__model-canvas:empty { display: none; }
  .pj__model-note { margin-top: var(--s-3); opacity: .75; }
  .pj__note { margin-top: var(--s-3); }
  .pj__texts { display: grid; gap: var(--s-6); }
  @media (min-width: 900px) { .pj__texts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pj__text p { margin-top: var(--s-3); }
  .pj__items { margin: var(--s-3) 0 0; padding-left: 1.1em; }
  .pal { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: flex; flex-wrap: wrap; gap: var(--s-5); }
  .pal__c { display: flex; flex-direction: column; align-items: center; gap: .4rem; width: 7.5rem; text-align: center; }
  .pal__chip { width: 5rem; height: 5rem; border-radius: 50%; box-shadow: var(--shadow-2), inset 0 0 0 1px rgb(0 0 0 / .08); }
  .cards { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); }
  .card { display: flex; flex-direction: column; gap: .3rem; }
  .card__img { display: block; aspect-ratio: 1; overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-1); background: #fff; }
  .card__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .card__name { font-family: var(--f-display); font-size: 1rem; line-height: 1.25; margin-top: .3rem; }
  .cards--list { grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: var(--s-3) var(--s-5); }
  .cards--list .card { border-left: 2px solid var(--gold); padding-left: .8rem; }
  .feats { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .feats li { display: grid; grid-template-columns: 40px 1fr; gap: .8rem; color: var(--c-leather); }
  .feats p { margin: 0; color: var(--ink); }
  .feats__t { font-family: var(--f-display); font-size: 1.05rem; line-height: 1.3; }
  .compare { display: grid; gap: var(--s-5); margin-top: var(--s-5); }
  @media (min-width: 900px) { .compare { grid-template-columns: 1fr 1fr; align-items: center; } }
  .compare figure { margin: 0; }
  .compare :global(img) { width: 100%; height: auto; box-shadow: var(--shadow-1); }
  .compare figcaption { margin-top: .5rem; }
  .stats { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); margin: var(--s-5) 0 0; }
  .stats dd { margin: .2rem 0 0; font-family: var(--f-display); font-size: clamp(1.6rem, 3vw, 2.4rem); color: var(--accent); line-height: 1.1; }
  .drawings { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: grid; gap: var(--s-6); grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); align-items: end; }
  .drawings--small { grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .drawings figure { margin: 0; }
  .drawings :global(img) { width: 100%; height: auto; background: #fff; }
  .drawings--small :global(img) { max-width: 520px; }
  .drawings figcaption { margin-top: .5rem; }
  .legends { display: grid; gap: var(--s-6); grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); margin-top: var(--s-5); }
  .legend { list-style: none; padding: 0; margin: .6rem 0 0; }
  .legend li { margin-bottom: .25em; }
  .legend__k { display: inline-grid; place-items: center; width: 1.6em; height: 1.6em; margin-right: .5em; border-radius: 50%; background: var(--c-olive); color: var(--paper); font-family: var(--f-label); font-size: .8em; }
  .gallery { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .gallery figure { margin: 0; }
  .gallery :global(img) { width: 100%; height: auto; box-shadow: var(--shadow-1); }
  .gallery figcaption { margin-top: .4rem; }
  .pj__nav { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--s-5); align-items: center; margin-top: var(--s-9); padding-top: var(--s-6); border-top: 1px solid var(--rule); }
  .pj__prev, .pj__next { display: flex; flex-direction: column; text-decoration: none; font-family: var(--f-display); }
  .pj__next { text-align: right; }
  @media (max-width: 700px) {
    .pj__nav { grid-template-columns: 1fr 1fr; }
    .pj__nav .btn { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
  }
</style>
