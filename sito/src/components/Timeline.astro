---
/* Timeline del CV, chiusa nel cassetto "Experience" dentro About (06-tocco-unico.md, tocco #5).
   <details> funziona senza JavaScript. Aggancio F6: [data-drawer="experience"]. */
import cv from '../content/cv.json';
---
<details class="drawer" data-drawer="experience">
  <summary class="drawer__pull">
    <span class="label">Experience</span>
    <span class="drawer__hint small">Career, education & awards</span>
  </summary>
  <div class="drawer__body">
    <p class="lede drawer__profile">{cv.profile}</p>
    <div class="drawer__cols">
      <section aria-labelledby="tl-work">
        <h3 class="heading" id="tl-work">Work experience</h3>
        <ol class="tl">
          {cv.experience.map((e) => (
            <li class="tl__item">
              <p class="label tl__date">{e.from} – {e.to}</p>
              <p class="tl__role">{e.role}</p>
              <p class="small tl__org">{e.org} · {e.place}</p>
              {e.points.length > 0 && <ul class="small tl__points">{e.points.map((x) => <li>{x}</li>)}</ul>}
            </li>
          ))}
        </ol>
      </section>
      <div>
        <section aria-labelledby="tl-edu">
          <h3 class="heading" id="tl-edu">Education</h3>
          <ol class="tl">
            {cv.education.map((e) => (
              <li class="tl__item"><p class="label tl__date">{e.from} – {e.to}</p><p class="tl__role">{e.title}</p><p class="small tl__org">{e.org} · {e.place}</p></li>
            ))}
          </ol>
        </section>
        <section aria-labelledby="tl-awards">
          <h3 class="heading" id="tl-awards">Scholarships & awards</h3>
          <ol class="tl">
            {cv.awards.map((a) => (
              <li class="tl__item"><p class="label tl__date">{a.from} – {a.to}</p><p class="tl__role">{a.title}</p><p class="small">{a.text}</p></li>
            ))}
          </ol>
        </section>
        <section aria-labelledby="tl-lang">
          <h3 class="heading" id="tl-lang">Languages & skills</h3>
          <ul class="small drawer__langs">{cv.languages.map((l) => <li><b>{l.name}</b> — {l.level}</li>)}</ul>
          <p class="small"><b>Software:</b> {cv.skills.hard.join(' · ')}</p>
          <p class="small">{cv.skills.soft.join(' · ')}</p>
        </section>
      </div>
    </div>
  </div>
</details>

<style>
  .drawer { margin-top: var(--s-8); text-align: left; }
  .drawer__pull {
    list-style: none; cursor: pointer; width: fit-content; margin: 0 auto var(--s-6);
    display: flex; align-items: center; gap: 1rem; padding: .85rem 1.8rem .85rem 1.3rem;
    border: 1px solid var(--gold); border-radius: var(--r-round);
    background: color-mix(in srgb, var(--paper) 85%, transparent); box-shadow: var(--shadow-1);
    transition: background .25s, border-color .25s, box-shadow .25s, transform .25s;
  }
  .drawer__pull::-webkit-details-marker { display: none; }
  .drawer__pull::before {
    content: "+"; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%;
    font-family: var(--f-display); font-size: 1.4rem; line-height: 1; color: var(--paper); background: var(--accent);
    transition: transform .3s;
  }
  .drawer[open] .drawer__pull::before { content: "–"; }
  .drawer__pull:hover, .drawer__pull:focus-visible { border-color: var(--accent); box-shadow: var(--shadow-2); transform: translateY(-1px); outline: none; }
  .drawer__pull .label { font-size: .85rem; }
  .drawer__hint { opacity: .7; }
  @media (max-width: 600px) { .drawer__hint { display: none; } }
  .drawer__body { padding-bottom: var(--s-7); }
  .drawer__profile { max-width: 60rem; }
  .drawer__cols { display: grid; gap: var(--s-7); margin-top: var(--s-6); }
  @media (min-width: 900px) { .drawer__cols { grid-template-columns: 1.2fr 1fr; } }
  .drawer__cols section + section { margin-top: var(--s-6); }
  .tl { list-style: none; margin: var(--s-4) 0 0; padding: 0 0 0 1.4rem; border-left: 1px solid var(--gold); }
  .tl__item { position: relative; padding-bottom: var(--s-5); }
  .tl__item::before { content: ""; position: absolute; left: calc(-1.4rem - 5px); top: .45em; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
  .tl__item p { margin: 0; }
  .tl__date { color: var(--accent); }
  .tl__role { font-family: var(--f-display); font-size: 1.15rem; line-height: 1.25; margin: .2em 0 !important; }
  .tl__points { margin-top: .4em; padding-left: 1.1em; }
  .drawer__langs { list-style: none; padding: 0; margin: var(--s-3) 0; }
</style>
