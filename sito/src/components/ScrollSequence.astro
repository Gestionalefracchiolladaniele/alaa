---
/* SEGNAPOSTO per la sequenza video legata allo scroll (01-architettura.md, "Pipeline delle sequenze").
   Lo costruisce Fable (TODO blocco B). Ora mostra solo l'immagine di riserva, ferma.
   Agganci:
     [data-scroll-sequence]   nome della clip ("clip-1", "clip-2"): i fotogrammi saranno in
                              /sequences/<clip>/{desktop,mobile}/0001.webp
     data-frames-desktop / data-frames-mobile   numero di fotogrammi attesi (120 / 60)
     data-fallback-slot       slot usato in modalita' di riserva (zoom lento + spostamento)
     [data-sequence-canvas]   posto per il <canvas>
     [data-sequence-fallback] contenitore dell'immagine di riserva */
import Slot from './Slot.astro';
interface Props { clip: string; fallback: string; class?: string; eager?: boolean }
const { clip, fallback, class: cls, eager = false } = Astro.props;
---
<div class:list={['seq', cls]} data-scroll-sequence={clip} data-frames-desktop="120" data-frames-mobile="60" data-fallback-slot={fallback}>
  <div class="seq__canvas" data-sequence-canvas></div>
  <div class="seq__fallback" data-sequence-fallback>
    <Slot id={fallback} sizes="100vw" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  </div>
</div>
<style>
  .seq { position: relative; overflow: hidden; }
  .seq__canvas { position: absolute; inset: 0; }
  .seq__fallback :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
