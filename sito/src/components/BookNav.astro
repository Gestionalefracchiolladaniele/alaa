---
/* Menu a pila di libri. Fisso in basso a destra su desktop; su mobile un pulsante apre il pannello.
   Funziona senza JavaScript (ancore). Lo script minimo apre/chiude il pannello su mobile.
   Aggancio per il movimento (F6): [data-booknav] e [data-book="<id>"]; il libro della sezione corrente
   riceve aria-current="true" (da impostare con IntersectionObserver in F6). */
import site from '../content/site.json';
interface Props { variant?: 'fixed' | 'inline'; current?: string }
const { variant = 'fixed', current } = Astro.props;
const tints = ['#5a4033', '#4e3a2f', '#614536', '#533f33', '#5c3f30', '#4a372c'];
---
<nav class:list={['booknav', `booknav--${variant}`]} aria-label="Sections" data-booknav>
  {variant === 'fixed' && (
    <button class="booknav__toggle" type="button" aria-expanded="false" aria-controls="booknav-list" data-booknav-toggle>
      <span class="label">Index</span><span class="booknav__arrow" aria-hidden="true"></span>
    </button>
  )}
  <ul class="booknav__stack" id={variant === 'fixed' ? 'booknav-list' : undefined}>
    {site.nav.map((item, i) => (
      <li style={`--i:${i}; --book-c:${tints[i % tints.length]}`}>
        <a class="book booknav__book" href={item.href} data-book={item.id}
           aria-current={current === item.id ? 'true' : undefined}>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .booknav__stack { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 3px; }
  .booknav__book {
    height: 38px; font-size: 0.8rem; padding: 0 1.4rem; white-space: nowrap;
    transition: transform .25s ease;
  }
  .booknav li:nth-child(odd) .booknav__book { margin-left: 6px; }
  .booknav li:nth-child(3n) .booknav__book { margin-right: 8px; }
  .booknav__book:hover, .booknav__book:focus-visible, .booknav__book[aria-current='true'] { transform: translateX(-14px); }

  .booknav--fixed { position: fixed; right: clamp(10px, 2vw, 28px); bottom: clamp(48px, 7vh, 80px); z-index: 60; }
  .booknav--fixed .booknav__stack { width: 8.4rem; gap: 2px; filter: drop-shadow(0 4px 8px rgb(40 25 10 / .22)); }
  .booknav--fixed .booknav__book { height: 22px; font-size: .58rem; padding: 0 .7rem; }
  .booknav--fixed .booknav__book:hover, .booknav--fixed .booknav__book:focus-visible, .booknav--fixed .booknav__book[aria-current='true'] { transform: translateX(-8px); }
  .booknav--fixed { transition: opacity .4s, visibility .4s; }
  :global(html.at-finale) .booknav--fixed { opacity: 0; visibility: hidden; }
  /* pulsante per aprire e chiudere il menu (scelta di Daniele, 13 nov): anche sul computer */
  .booknav--fixed { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .booknav--fixed .booknav__toggle {
    order: 2; display: inline-flex; align-items: center; gap: .5em; padding: .45em .8em; border-radius: 3px;
    background: var(--c-leather); border: 0; cursor: pointer; box-shadow: var(--shadow-2);
  }
  .booknav--fixed .booknav__toggle .label { color: var(--c-gold-book); font-size: .6rem; }
  .booknav__arrow { width: .45em; height: .45em; border-right: 1.5px solid var(--c-gold-book); border-bottom: 1.5px solid var(--c-gold-book); transform: rotate(45deg) translateY(-2px); transition: transform .25s; }
  @media (min-width: 900px) {
    .booknav--fixed.is-closed .booknav__stack { display: none; }
    .booknav--fixed.is-closed .booknav__arrow { transform: rotate(-135deg) translateY(-2px); }
  }

  @media (max-width: 899px) {
    .booknav--fixed .booknav__toggle {
      display: inline-flex; align-items: center; gap: .5em; padding: .75em 1.1em; border-radius: 3px;
      background: var(--c-leather); border: 0; cursor: pointer; box-shadow: var(--shadow-2);
    }
    .booknav--fixed .booknav__toggle .label { color: var(--c-gold-book); }
    .booknav--fixed .booknav__stack { display: none; position: absolute; right: 0; bottom: calc(100% + 10px); }
    .booknav--fixed.is-open .booknav__stack { display: flex; }
  }

  .booknav--inline .booknav__stack { width: min(20rem, 100%); margin-inline: auto; }
  .booknav--inline .booknav__book { height: 46px; font-size: 0.95rem; }
</style>

<script>
  // Telefono: il pulsante apre il pannello (chiuso di partenza).
  // Computer: il menu e' aperto; il pulsante lo chiude e lo riapre, e la scelta resta ricordata.
  const desktop = () => window.matchMedia('(min-width: 900px)').matches;
  const KEY = 'aa-booknav-closed';
  for (const nav of document.querySelectorAll<HTMLElement>('[data-booknav]')) {
    const btn = nav.querySelector<HTMLButtonElement>('[data-booknav-toggle]');
    if (!btn) continue;
    const sync = () => btn.setAttribute('aria-expanded', String(desktop() ? !nav.classList.contains('is-closed') : nav.classList.contains('is-open')));
    try { if (localStorage.getItem(KEY) === '1') nav.classList.add('is-closed'); } catch { /* niente */ }
    sync();
    btn.addEventListener('click', () => {
      if (desktop()) {
        const closed = nav.classList.toggle('is-closed');
        try { localStorage.setItem(KEY, closed ? '1' : '0'); } catch { /* niente */ }
      } else {
        nav.classList.toggle('is-open');
      }
      sync();
    });
    nav.addEventListener('click', (e) => {
      if (!desktop() && (e.target as HTMLElement).closest('a')) { nav.classList.remove('is-open'); sync(); }
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', sync);
  }
</script>
